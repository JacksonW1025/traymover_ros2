<?xml version="1.0"?>
<sdf version="1.9">
  <world name="traymover_detour">
    <gravity>0 0 -9.81</gravity>
    <physics name="default_physics" type="ode"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene><ambient>0.4 0.4 0.4 1</ambient><background>0.7 0.7 0.7 1</background></scene>

    <model name="floor">
      <static>true</static><link name="link">
        <collision name="collision"><geometry><box><size>8 6 0.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8 6 0.1</size></box></geometry><material><ambient>0.75 0.75 0.75 1</ambient></material></visual>
      </link>
      <pose>4 0 -0.05 0 0 0</pose>
    </model>

    <!-- Bounds are x=[0,8], y=[-3,3]. -->
    <model name="wall_west"><static>true</static><pose>0 -0.0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.1 6 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.1 6 1</size></box></geometry></visual></link></model>
    <model name="wall_east"><static>true</static><pose>8 0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.1 6 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.1 6 1</size></box></geometry></visual></link></model>
    <model name="wall_north"><static>true</static><pose>4 3 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>8 0.1 1</size></box></geometry></collision><visual name="v"><geometry><box><size>8 0.1 1</size></box></geometry></visual></link></model>
    <model name="wall_south"><static>true</static><pose>4 -3 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>8 0.1 1</size></box></geometry></collision><visual name="v"><geometry><box><size>8 0.1 1</size></box></geometry></visual></link></model>

    <!-- Unequal blocks force a choice between a short lower route and a longer upper route. -->
    <model name="static_block_north"><static>true</static><pose>3.4 1.25 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>1.0 1.2 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 1.2 1.0</size></box></geometry><material><ambient>0.25 0.25 0.30 1</ambient></material></visual></link></model>
    <model name="static_block_south"><static>true</static><pose>4.6 -1.2 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>1.4 1.0 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.4 1.0 1.0</size></box></geometry><material><ambient>0.30 0.25 0.25 1</ambient></material></visual></link></model>
  </world>
</sdf>
