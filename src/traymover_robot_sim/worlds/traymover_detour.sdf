<?xml version="1.0"?>
<sdf version="1.9">
  <world name="traymover_detour">
    <gravity>0 0 -9.81</gravity>
    <physics name="default_physics" type="ode"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene><ambient>0.65 0.65 0.65 1</ambient><background>0.88 0.92 0.98 1</background></scene>

    <!-- Start Gazebo's 3D view above the complete 8 x 6 m demo area. -->
    <gui fullscreen="false">
      <plugin name="3D View" filename="GzScene3D">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.8 0.8 0.8</ambient_light>
        <background_color>0.88 0.92 0.98</background_color>
        <camera_pose>4 0 9 0 1.5708 0</camera_pose>
      </plugin>
    </gui>

    <light type="directional" name="sun">
      <pose>4 -4 10 0.35 0.2 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
    </light>

    <model name="floor">
      <static>true</static><link name="link">
        <collision name="collision"><geometry><box><size>8 6 0.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8 6 0.1</size></box></geometry><material><ambient>0.42 0.50 0.58 1</ambient><diffuse>0.58 0.68 0.78 1</diffuse><specular>0.15 0.15 0.15 1</specular></material></visual>
      </link>
      <pose>4 0 -0.05 0 0 0</pose>
    </model>

    <!-- Bounds are x=[0,8], y=[-3,3]. -->
    <model name="wall_west"><static>true</static><pose>0 -0.0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.1 6 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.1 6 1</size></box></geometry><material><ambient>0.02 0.18 0.65 1</ambient><diffuse>0.04 0.35 0.95 1</diffuse></material></visual></link></model>
    <model name="wall_east"><static>true</static><pose>8 0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.1 6 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.1 6 1</size></box></geometry><material><ambient>0.45 0.08 0.55 1</ambient><diffuse>0.75 0.15 0.75 1</diffuse></material></visual></link></model>
    <model name="wall_north"><static>true</static><pose>4 3 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>8 0.1 1</size></box></geometry></collision><visual name="v"><geometry><box><size>8 0.1 1</size></box></geometry><material><ambient>0.02 0.45 0.25 1</ambient><diffuse>0.05 0.75 0.35 1</diffuse></material></visual></link></model>
    <model name="wall_south"><static>true</static><pose>4 -3 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>8 0.1 1</size></box></geometry></collision><visual name="v"><geometry><box><size>8 0.1 1</size></box></geometry><material><ambient>0.65 0.35 0.02 1</ambient><diffuse>0.95 0.60 0.05 1</diffuse></material></visual></link></model>

    <!-- The boundary walls provide the fixed scene geometry.  The runtime
         box below is the only obstacle that should trigger detouring, which
         leaves generous clearance for a robust prototype demonstration. -->
  </world>
</sdf>
