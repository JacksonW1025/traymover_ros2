#!/usr/bin/env python3
"""Keyboard emergency-stop control for the Traymover safety service."""

import os
import select
import sys

import rclpy
from rclpy.qos import DurabilityPolicy, QoSProfile, ReliabilityPolicy
from std_msgs.msg import Bool
from std_srvs.srv import SetBool

if os.name != 'nt':
    import termios
    import tty


HELP = """
Traymover EStop Keyboard
------------------------
  e or space : EStop
  f or r     : Free
  q          : quit this keyboard process
"""

ESTOP_SERVICE = '/traymover_estop/set'
ESTOP_STATE_TOPIC = '/traymover_estop/state'


def get_key(settings):
    if os.name == 'nt':
        import msvcrt
        return msvcrt.getch().decode('utf-8')

    tty.setraw(sys.stdin.fileno())
    rlist, _, _ = select.select([sys.stdin], [], [], 0.1)
    key = sys.stdin.read(1) if rlist else ''
    termios.tcsetattr(sys.stdin, termios.TCSADRAIN, settings)
    return key


def call_estop_service(node, client, value):
    if not client.wait_for_service(timeout_sec=0.5):
        node.get_logger().warn(f'{ESTOP_SERVICE} is not available yet')
        return

    request = SetBool.Request()
    request.data = bool(value)
    future = client.call_async(request)
    rclpy.spin_until_future_complete(node, future, timeout_sec=2.0)
    if not future.done():
        node.get_logger().warn(f'{ESTOP_SERVICE} call timed out')
        return

    response = future.result()
    if response is None:
        node.get_logger().warn(f'{ESTOP_SERVICE} call failed')
        return

    node.get_logger().info(response.message)


def main():
    if os.name != 'nt' and not sys.stdin.isatty():
        print('traymover_estop_keyboard requires an interactive terminal')
        return 1

    settings = termios.tcgetattr(sys.stdin) if os.name != 'nt' else None

    rclpy.init()
    node = rclpy.create_node('traymover_estop_keyboard')
    client = node.create_client(SetBool, ESTOP_SERVICE)
    state = {'last': None}

    def on_state(msg: Bool):
        if state['last'] == msg.data:
            return
        state['last'] = msg.data
        print(f"\n[traymover_estop] {'ESTOP' if msg.data else 'FREE'}")

    node.create_subscription(
        Bool,
        ESTOP_STATE_TOPIC,
        on_state,
        QoSProfile(
            depth=1,
            reliability=ReliabilityPolicy.RELIABLE,
            durability=DurabilityPolicy.TRANSIENT_LOCAL,
        ),
    )

    try:
        print(HELP)
        while rclpy.ok():
            rclpy.spin_once(node, timeout_sec=0.0)
            key = get_key(settings)
            if key in ('e', 'E', ' '):
                call_estop_service(node, client, True)
            elif key in ('f', 'F', 'r', 'R'):
                call_estop_service(node, client, False)
            elif key in ('q', 'Q', '\x03'):
                break
    finally:
        if os.name != 'nt':
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, settings)
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()

    return 0


if __name__ == '__main__':
    raise SystemExit(main())
